{
  "name": "dsh-math-calculator",
  "version": "2.0.0",
  "private": false,
  "description": "DSH 原生数学与架空世界推演插件：BigNumber 高精度、符号微积分、线代（秩/零空间/奇异值）、统计概率、微分方程、342 条自然科学公式（三轴标签）、物理常数推演、星球/天空/恒星/卫星/生命闸门推演。全部本地执行。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "author": "czkssg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czkssg/dsh-math-calculator.git",
    "directory": "dsh-math-calculator"
  },
  "homepage": "https://github.com/czkssg/dsh-math-calculator#readme",
  "bugs": {
    "url": "https://github.com/czkssg/dsh-math-calculator/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.1.1-rc.2 <0.4.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.1.1-rc.2 <0.4.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "algebrite": "^1.4.0",
    "mathjs": "^15.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-0 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/run.mjs",
    "test:all": "node run-all-tests.mjs",
    "preflight": "node scripts/preflight.mjs",
    "doccheck": "node scripts/doc-coverage.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test:all && npm run preflight"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "math",
    "bigdecimal",
    "symbolic",
    "calculus",
    "linear-algebra",
    "statistics",
    "worldbuilding",
    "astronomy",
    "exoplanet"
  ]
}
